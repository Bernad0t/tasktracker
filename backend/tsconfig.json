{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,                          // Включает целый ряд строгих проверок
        "noImplicitAny": true,                   // Требует явное указание типа any для неявно типизированных объектов
        "noImplicitThis": true,                  // Проверяет this контекст для методов
        "alwaysStrict": true,                    // Включает режим строгого соответствия стандарту JavaScript
        "strictNullChecks": true,                // Требует явную проверку на null и undefined
        "strictFunctionTypes": true,             // Включает строгую проверку для типов функций
        "strictPropertyInitialization": true,    // Требует инициализацию всех свойств классов не в конструкторе
        "esModuleInterop": true,                 // Обеспечивает совместимость с экосистемой CommonJS
        "skipLibCheck": true,                    // Пропускает проверку деклараций типов библиотек на совместимость
        "forceConsistentCasingInFileNames": true, // Требует согласования регистра символов в именах файлов
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
    }
  }